---
const marks = ["AI", "RULES", "GRAPH", "FEEDBACK"];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <a class="brand footer-brand" href="/" aria-label="LinkOS homepage">
        <span class="brand-mark" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
        <span class="brand-word">LinkOS</span>
      </a>
      <p>Automating ecosystem linkages without removing admin control.</p>
      <div class="footer-contact">
        <a href="mailto:demo@linkos.local">demo@linkos.local</a>
        <a href="tel:+60000000000">+60 00 000 0000</a>
      </div>
    </div>

    <div class="footer-middle">
      <nav aria-label="Footer services">
        <p class="eyebrow">Matching pipeline</p>
        <a href="/projects/">Profile extraction</a>
        <a href="/projects/">Eligibility filtering</a>
        <a href="/projects/">Weighted scoring</a>
        <a href="/projects/">Feedback learning</a>
      </nav>
      <nav aria-label="Footer links">
        <p class="eyebrow">Demo links</p>
        <a href="/blog/">High relationship mentors</a>
        <a href="/services/">Mentor detail</a>
      </nav>
      <div class="award-grid" aria-label="Membership placeholders">
        {marks.map((mark) => <span>{mark}</span>)}
      </div>
    </div>

    <div class="footer-divider" aria-hidden="true">
      <span></span>
      <i>0px</i>
      <span></span>
    </div>

    <div class="footer-bottom">
      <span>© 2026 LinkOS. Hackathon prototype.</span>
      <a href="/projects/">Privacy Policy</a>
      <a href="/projects/">AI Policy</a>
    </div>
  </div>
</footer>
