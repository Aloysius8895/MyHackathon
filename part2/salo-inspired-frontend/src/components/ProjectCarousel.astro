---
import { projects } from "../data/projects";
---

<section class="section projects-section" data-first>
  <div class="stack xl-gap">
    <div class="container carousel-header">
      <div>
        <p class="eyebrow">Matching engine modules</p>
        <h1>Projects</h1>
      </div>
      <div class="carousel-controls" data-carousel-controls>
        <button class="icon-button" type="button" data-carousel-prev aria-label="Previous project">
          <span aria-hidden="true">←</span>
        </button>
        <div class="progress-track" aria-hidden="true">
          <span class="progress-fill" data-carousel-progress></span>
        </div>
        <button class="icon-button" type="button" data-carousel-next aria-label="Next project">
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <div class="carousel-shell">
      <ul class="project-carousel" data-carousel>
        {projects.map((project) => (
          <li class="project-slide">
            <a class="project-card project-copy-card" href={`/projects/${project.slug}/`}>
              <div class="card-frame desktop-frame">
                <img src={project.desktopImage} alt={`${project.client} desktop project mockup`} loading="lazy" />
              </div>
              <div class="client-lockup">
                <span class="logo-card" aria-hidden="true">{project.logoText}</span>
                <span class="client-name">{project.client}</span>
              </div>
              <span class="tag" style={`--tag-color:${project.categoryColor}`}>{project.category}</span>
              <h2>{project.title}</h2>
              <p>{project.description}</p>
              <span class="button button-secondary project-button">
                View module
                <span aria-hidden="true">→</span>
              </span>
            </a>

            <a class="project-card project-phone-card" href={`/projects/${project.slug}/`} aria-label={`View ${project.client}`}>
              <div class="phone-chrome" aria-hidden="true"></div>
              <img src={project.mobileImage} alt={`${project.client} mobile project mockup`} loading="lazy" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
