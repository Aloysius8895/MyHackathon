---
import "../styles/global.css";

const {
  title = "Projects - Studio Relay",
  description = "A Salo-inspired project carousel rebuilt with original assets.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
