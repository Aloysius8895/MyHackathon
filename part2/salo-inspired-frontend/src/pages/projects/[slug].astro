---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<BaseLayout title={`${project.client} - Studio Relay`}>
  <Header />
  <main class="placeholder-page">
    <section class="container detail-placeholder">
      <a class="back-link" href="/projects/">← Back to matching engine</a>
      <div class="detail-grid">
        <div>
          <p class="eyebrow">{project.category}</p>
          <h1>{project.client}</h1>
          <p>{project.title}</p>
          <p>{project.description}</p>
        </div>
        <div class="card-frame detail-image">
          <img src={project.desktopImage} alt={`${project.client} desktop mockup`} />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
