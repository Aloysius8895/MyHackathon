---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<BaseLayout title="About LinkOS">
  <Header />
  <main class="placeholder-page">
    <section class="container placeholder-hero">
      <p class="eyebrow">Problem statement</p>
      <h1>Automating ecosystem linkages</h1>
      <p>
        LinkOS treats company, mentor, programme, partner, and service-provider
        relationships as first-class entities. Instead of one-off manual
        coordination, the system extracts structured profiles, filters eligibility,
        retrieves candidates, scores matches, explains recommendations, requires
        admin approval, and learns from relationship outcomes.
      </p>
      <a class="button button-primary js-glow" href="/projects/">View the matching engine</a>
    </section>
  </main>
  <Footer />
</BaseLayout>
