---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
---

<BaseLayout title="LinkOS">
  <Header />
  <main class="placeholder-page">
    <section class="container placeholder-hero">
      <p class="eyebrow">Homepage placeholder</p>
      <h1>LinkOS</h1>
      <p>
        A hackathon prototype for automating ecosystem linkages: extracting profiles,
        matching companies to mentors, creating reusable relationship entities, and
        learning from feedback.
      </p>
      <a class="button button-primary js-glow" href="/projects/">View matching engine</a>
    </section>
  </main>
</BaseLayout>
